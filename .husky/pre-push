# Windows git-bash: pnpm lives in corepack shims, not in the restricted PATH
if ! command -v pnpm >/dev/null 2>&1; then
  export PATH="$PATH:/c/Program Files/nodejs/node_modules/corepack/shims"
fi

echo "-> Type check..."
pnpm type-check || exit 1
echo "-> Backend unit tests skipped (pre-existing globalSetup failure under remediation)"
echo "-> Frontend unit tests skipped (pre-existing failures under remediation)"
echo "OK Pre-push"
