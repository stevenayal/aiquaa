{
  "name": "aiquaa-monorepo",
  "private": true,
  "packageManager": "pnpm@9",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "postinstall": "pnpm -r install",
    "build": "pnpm -r build",
    "dev": "concurrently -n FRONT,BACK -c auto \"pnpm --filter @aiquaa/frontend dev\" \"pnpm --filter @aiquaa/backend start:dev\"",
    "dev:front": "pnpm --filter @aiquaa/frontend dev",
    "dev:back": "pnpm --filter @aiquaa/backend start:dev",
    "lint": "pnpm -r lint",
    "verify": "node scripts/verify-setup.js"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.0.0",
    "eslint-config-prettier": "^9.0.0"
  }
}
