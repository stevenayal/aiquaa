{
  "name": "aiquaa-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @aiquaa/allpairs-core build && pnpm --filter @aiquaa/frontend build",
    "build:vercel": "pnpm --filter @aiquaa/allpairs-core build && pnpm --filter @aiquaa/frontend run build",
    "dev": "pnpm dev:front",
    "dev:front": "pnpm --filter @aiquaa/frontend dev",
    "lint": "pnpm --filter @aiquaa/frontend lint",
    "verify": "pnpm lint && pnpm test:cov",
    "test": "pnpm --filter @aiquaa/frontend test",
    "test:cov": "pnpm --filter @aiquaa/frontend test:cov",
    "test:watch": "pnpm --filter @aiquaa/frontend test:watch",
    "e2e": "pnpm --filter @aiquaa/frontend e2e",
    "e2e:report": "pnpm --filter @aiquaa/frontend e2e:report",
    "adr:new": "node tools/adr-new.mjs",
    "adr:list": "ls -1 docs/adr | sort",
    "prepare": "node -e \"try { require('child_process').execSync('husky', {stdio: 'ignore'}); } catch(e) {}\"",
    "commit": "git-cz",
    "lint-staged": "lint-staged",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "pnpm --filter @aiquaa/frontend type-check"
  },
  "lint-staged": {
    "apps/frontend/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.ts": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.0.0",
    "eslint-config-prettier": "^9.0.0",
    "coverage-badges": "^1.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3"
  },
  "pnpm": {
    "overrides": {
      "next-auth": "4.24.11"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "security": {
      "minimumReleaseAge": "1440m"
    }
  }
}
