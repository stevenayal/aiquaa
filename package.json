{
  "name": "aiquaa-monorepo",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "pnpm -r build",
    "build:vercel": "pnpm --filter @aiquaa/allpairs-core build && pnpm --filter @aiquaa/frontend run build",
    "build:backend": "pnpm --filter @aiquaa/backend build",
    "start:prod": "pnpm --filter @aiquaa/backend start:prod",
    "prisma:generate": "pnpm --filter @aiquaa/backend prisma:generate",
    "dev": "concurrently -n FRONT,BACK -c auto \"pnpm --filter @aiquaa/frontend dev\" \"pnpm --filter @aiquaa/backend start:dev\"",
    "dev:front": "pnpm --filter @aiquaa/frontend dev",
    "dev:back": "pnpm --filter @aiquaa/backend start:dev",
    "lint": "pnpm -r lint",
    "verify": "pnpm -r lint && pnpm -r test:cov",
    "test": "pnpm -r test",
    "test:cov": "pnpm -r test:cov",
    "test:watch": "pnpm -r test:watch",
    "test:contract": "pnpm --filter @aiquaa/backend test:contract",
    "e2e": "pnpm --filter @aiquaa/frontend e2e",
    "e2e:report": "pnpm --filter @aiquaa/frontend e2e:report",
    "perf:forum": "k6 run perf/k6/forum-smoke.js",
    "test:email": "node scripts/run-tests-with-email.js all",
    "test:email:unit": "node scripts/run-tests-with-email.js unit",
    "test:email:e2e": "node scripts/run-tests-with-email.js e2e",
    "test:email:contract": "node scripts/run-tests-with-email.js contract",
    "adr:new": "node tools/adr-new.mjs",
    "adr:list": "ls -1 docs/adr | sort",
    "prepare": "node -e \"try { require('child_process').execSync('husky', {stdio: 'ignore'}); } catch(e) {}\"",
    "commit": "git-cz",
    "lint-staged": "lint-staged",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "pnpm --filter @aiquaa/frontend type-check && pnpm --filter @aiquaa/backend type-check",
    "pr-check": "bash scripts/pr-check.sh"
  },
  "lint-staged": {
    "apps/frontend/**/*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "apps/backend/**/*.ts": ["eslint --fix", "prettier --write"],
    "packages/**/*.ts": ["prettier --write"],
    "*.{json,md,yml,yaml}": ["prettier --write"]
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.0.0",
    "eslint-config-prettier": "^9.0.0",
    "coverage-badges": "^1.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3"
  },
  "pnpm": {
    "overrides": {
      "next-auth": "4.24.11"
    }
  }
}
