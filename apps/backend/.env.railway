# Variables de entorno para Railway - AIQUAA Backend
# Copiar estas variables a la configuración de Railway

# Node Environment
NODE_ENV=production

# Backend Configuration
BACKEND_PORT=${PORT}
BACKEND_URL=${RAILWAY_PUBLIC_DOMAIN}
FRONT_ORIGIN=https://aiquaa.com,https://www.aiquaa.com,https://aiquaa.vercel.app
APP_URL=${RAILWAY_PUBLIC_DOMAIN}

# Database - Railway PostgreSQL (Railway auto-configura DATABASE_URL)
DATABASE_URL=${DATABASE_URL}
POSTGRES_URL=${DATABASE_URL}

# JWT Configuration
JWT_SECRET=${JWT_SECRET}
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000
REFRESH_COOKIE_NAME=aiq_rt

# Email Configuration - Resend
RESEND_API_KEY=${RESEND_API_KEY}
RESEND_FROM_EMAIL="AIQUAA <noreply@aiquaa.com>"
ADMIN_EMAIL=admin@aiquaa.com

# OAuth Providers - Google
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}

# OAuth Providers - GitHub
GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID}
GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET}

# Logging
LOG_LEVEL=info

# IMPORTANTE: No configurar REDIS_URL si no tienes Redis en Railway
# Si lo necesitas, agrega el servicio Redis en Railway y conecta
