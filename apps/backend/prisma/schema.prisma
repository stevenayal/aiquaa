// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String?   // Nullable for OAuth users
  name            String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  twoFASecret     String?   // For 2FA setup
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  threads              Thread[]
  posts                Post[]
  enrollments          Enrollment[]
  purchases            Purchase[]
  oauthAccounts        OAuthAccount[]
  refreshTokens        RefreshToken[]
  verificationTokens   VerificationToken[]

  @@map("users")
  @@index([deletedAt])
  @@index([email])
  @@index([emailVerifiedAt])
}

model OAuthAccount {
  id             Int      @id @default(autoincrement())
  provider       OAuthProvider
  providerUserId String
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
  @@index([userId])
  @@index([provider, providerUserId])
}

model RefreshToken {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId Int?
  replacedByToken   RefreshToken? @relation("TokenReplacement", fields: [replacedByTokenId], references: [id])
  replacingTokens   RefreshToken[] @relation("TokenReplacement")
  ip                String?
  userAgent         String?

  @@map("refresh_tokens")
  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

model VerificationToken {
  id         Int                @id @default(autoincrement())
  userId     Int?
  user       User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String?
  type       VerificationType
  tokenHash  String             @unique
  createdAt  DateTime           @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@map("verification_tokens")
  @@index([type, email])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  threads Thread[]

  @@map("categories")
  @@index([deletedAt])
}

model Thread {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  slug       String   @unique
  isSticky   Boolean  @default(false)
  isLocked   Boolean  @default(false)
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  // Relations
  authorId   Int
  author     User       @relation(fields: [authorId], references: [id])
  categoryId Int
  category   Category   @relation(fields: [categoryId], references: [id])
  posts      Post[]
  threadTags ThreadTag[]

  @@map("threads")
  @@index([categoryId, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@index([viewCount(sort: Desc)])
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  isSolution Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id])
  threadId  Int
  thread    Thread  @relation(fields: [threadId], references: [id])

  @@map("posts")
  @@index([threadId, createdAt(sort: Desc)])
  @@index([deletedAt])
}

model ThreadTag {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  // Relations
  threads   Thread[]

  @@map("thread_tags")
  @@unique([name])
  @@index([name])
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  slug        String   @unique
  price       Decimal  @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  lessons    Lesson[]
  enrollments Enrollment[]

  @@map("courses")
  @@index([deletedAt])
}

model Lesson {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])

  @@map("lessons")
  @@index([deletedAt])
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  enrolledAt DateTime @default(now())

  // Relations
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Purchase {
  id        Int      @id @default(autoincrement())
  amount    Decimal
  status    PurchaseStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  @@map("purchases")
  @@index([deletedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String   // CREATE/UPDATE/DELETE
  userId    String?
  at        DateTime @default(now())
  payload   Json?

  @@map("audit_logs")
  @@index([entity, entityId, at])
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum VerificationType {
  VERIFY_EMAIL
  RESET_PASSWORD
  TWO_FACTOR_EMAIL
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}
