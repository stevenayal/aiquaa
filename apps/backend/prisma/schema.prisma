// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String?   // Nullable for OAuth users
  name            String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  twoFASecret     String?   // For 2FA setup
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  threads              Thread[]
  posts                Post[]
  enrollments          Enrollment[]
  purchases            Purchase[]
  oauthAccounts        OAuthAccount[]
  refreshTokens        RefreshToken[]
  verificationTokens   VerificationToken[]
  ideas                Idea[]
  ideaVotes            IdeaVote[]
  ideaComments         IdeaComment[]
  istqbResults         IstqbExamResult[]

  // Gamification
  userXp           UserXp?
  userAchievements UserAchievement[]
  xpHistory        XpHistory[]

  @@map("users")
  @@index([deletedAt])
  @@index([email])
  @@index([emailVerifiedAt])
}

model OAuthAccount {
  id             Int      @id @default(autoincrement())
  provider       OAuthProvider
  providerUserId String
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
  @@index([userId])
  @@index([provider, providerUserId])
}

model RefreshToken {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId Int?
  replacedByToken   RefreshToken? @relation("TokenReplacement", fields: [replacedByTokenId], references: [id])
  replacingTokens   RefreshToken[] @relation("TokenReplacement")
  ip                String?
  userAgent         String?

  @@map("refresh_tokens")
  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

model VerificationToken {
  id         Int                @id @default(autoincrement())
  userId     Int?
  user       User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String?
  type       VerificationType
  tokenHash  String             @unique
  createdAt  DateTime           @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@map("verification_tokens")
  @@index([type, email])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  threads Thread[]

  @@map("categories")
  @@index([deletedAt])
}

model Thread {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  slug       String   @unique
  isSticky   Boolean  @default(false)
  isLocked   Boolean  @default(false)
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  // Relations
  authorId   Int
  author     User       @relation(fields: [authorId], references: [id])
  categoryId Int
  category   Category   @relation(fields: [categoryId], references: [id])
  posts      Post[]
  threadTags ThreadTag[]

  @@map("threads")
  @@index([categoryId, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@index([viewCount(sort: Desc)])
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  isSolution Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id])
  threadId  Int
  thread    Thread  @relation(fields: [threadId], references: [id])

  @@map("posts")
  @@index([threadId, createdAt(sort: Desc)])
  @@index([deletedAt])
}

model ThreadTag {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  // Relations
  threads   Thread[]

  @@map("thread_tags")
  @@unique([name])
  @@index([name])
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  slug        String   @unique
  price       Decimal  @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  lessons    Lesson[]
  enrollments Enrollment[]

  @@map("courses")
  @@index([deletedAt])
}

model Lesson {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])

  @@map("lessons")
  @@index([deletedAt])
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  enrolledAt DateTime @default(now())

  // Relations
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Purchase {
  id        Int      @id @default(autoincrement())
  amount    Decimal
  status    PurchaseStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  @@map("purchases")
  @@index([deletedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String   // CREATE/UPDATE/DELETE
  userId    String?
  at        DateTime @default(now())
  payload   Json?

  @@map("audit_logs")
  @@index([entity, entityId, at])
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum VerificationType {
  VERIFY_EMAIL
  RESET_PASSWORD
  TWO_FACTOR_EMAIL
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model IstqbExamResult {
  id                  Int      @id @default(autoincrement())
  participantName     String
  participantEmail    String?
  userId              Int?
  user                User?    @relation(fields: [userId], references: [id])
  startTime           DateTime
  endTime             DateTime
  timeSpentSeconds    Int      // Tiempo total en segundos
  score               Int
  totalQuestions      Int
  percentage          Decimal  @db.Decimal(5,2)
  passed              Boolean
  mode                ExamMode @default(EXAM)
  answers             Json     // Array de respuestas completo
  learningObjectives  Json     // Análisis por Learning Objectives
  createdAt           DateTime @default(now())

  @@map("istqb_exam_results")
  @@index([participantEmail])
  @@index([userId])
  @@index([createdAt])
  @@index([passed])
}

model PerformanceExamResult {
  id                 Int                 @id @default(autoincrement())
  participantName    String
  githubProfile      String
  examPurpose        PerformanceExamPurpose
  companyName        String?
  startTime          DateTime
  endTime            DateTime
  timeSpentSeconds   Int      // Tiempo total en segundos
  score              Int
  totalQuestions     Int
  percentage         Decimal  @db.Decimal(5,2)
  passed             Boolean
  mode               String   // 'exam' o 'training'
  answers            Json     // Array de respuestas completo
  sectionAnalysis    Json     // Análisis por secciones
  createdAt          DateTime @default(now())

  @@map("performance_exam_results")
  @@index([githubProfile])
  @@index([createdAt])
  @@index([passed])
  @@index([examPurpose])
}

enum PerformanceExamPurpose {
  capacitacion
  postulacion
  practica
  otro
}

enum ExamMode {
  EXAM
  TRAINING
}

// ============================================================
// IDEAS BOARD MODELS
// ============================================================

model IdeaCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String?  // Emoji o nombre de icono
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  ideas Idea[]

  @@map("idea_categories")
  @@index([deletedAt])
  @@index([order])
}

model Idea {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  slug        String     @unique
  status      IdeaStatus @default(PENDING)
  categoryId  Int
  category    IdeaCategory @relation(fields: [categoryId], references: [id])
  authorId    Int
  author      User       @relation(fields: [authorId], references: [id])

  // Estadísticas
  viewCount   Int        @default(0)
  voteScore   Int        @default(0) // Suma neta de votos (upvotes - downvotes)
  upvotes     Int        @default(0)
  downvotes   Int        @default(0)

  // Metadata
  tags        String[]   // Array de strings para tags
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  // Relaciones
  votes       IdeaVote[]
  comments    IdeaComment[]

  @@map("ideas")
  @@index([categoryId, voteScore(sort: Desc)])
  @@index([status, voteScore(sort: Desc)])
  @@index([deletedAt])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
}

model IdeaVote {
  id        Int      @id @default(autoincrement())
  ideaId    Int
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int      // +1 para upvote, -1 para downvote
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ideaId, userId]) // Un usuario solo puede votar una vez por idea
  @@map("idea_votes")
  @@index([ideaId])
  @@index([userId])
}

model IdeaComment {
  id        Int      @id @default(autoincrement())
  content   String
  ideaId    Int
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("idea_comments")
  @@index([ideaId, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@index([authorId])
}

enum IdeaStatus {
  PENDING      // Nueva idea, pendiente de revisión
  APPROVED     // Aprobada, en backlog
  IN_PROGRESS  // En desarrollo
  COMPLETED    // Implementada
  REJECTED     // Rechazada
}

// ============================================================
// GAMIFICATION MODELS
// ============================================================

// XP rules configurable via DB — no deploy needed to change values
model XpRule {
  id          Int      @id @default(autoincrement())
  eventType   String   @unique
  xpAmount    Int
  description String
  dailyLimit  Int?     // null = unlimited per day
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  xpHistory XpHistory[]

  @@map("xp_rules")
  @@index([eventType, isActive])
}

// Achievement definitions
model Achievement {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  name          String
  description   String
  criteriaType  String   // ISTQB_COMPLETED_COUNT | ISTQB_PASSED_COUNT | ALLPAIRS_COUNT | ALLPAIRS_LARGE_COUNT | STREAK_DAYS | DAILY_LOGIN_COUNT | USER_LEVEL
  criteriaValue Int?
  xpBonus       Int      @default(0)
  icon          String?
  category      String   // ISTQB | ALLPAIRS | STREAK | COMMUNITY | GENERAL
  difficulty    String   // EASY | MEDIUM | HARD | LEGENDARY
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userAchievements UserAchievement[]

  @@map("achievements")
  @@index([isActive, category])
}

// Unlocked achievements per user
model UserAchievement {
  id            Int         @id @default(autoincrement())
  userId        Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId Int
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())
  source        String      // eventType that triggered the unlock
  xpAwarded     Int         @default(0)
  metadata      Json?

  @@unique([userId, achievementId])
  @@map("user_achievements")
  @@index([userId, unlockedAt(sort: Desc)])
  @@index([achievementId])
}

// Full XP event history — audit trail + idempotency
model XpHistory {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpRuleId         Int?
  xpRule           XpRule?  @relation(fields: [xpRuleId], references: [id])
  eventType        String
  xpAmount         Int
  source           String
  sourceId         String?
  // Prevents double-grants: set to "eventType:sourceId" when sourceId exists
  deduplicationKey String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@map("xp_history")
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, eventType, createdAt])
  @@index([userId, deduplicationKey])
}

// Aggregate XP state per user — single source of truth for leaderboard
model UserXp {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp        Int       @default(0)
  level          Int       @default(1)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("user_xp")
  @@index([totalXp(sort: Desc)])
}
