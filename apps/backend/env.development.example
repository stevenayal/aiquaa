# Configuración de desarrollo para el backend AIQUAA
# Copia este archivo como .env y configura las variables

# Database - Local PostgreSQL o Supabase
DATABASE_URL="postgresql://username:password@localhost:5432/aiquaa_dev"

# JWT Configuration
JWT_SECRET=dev-secret-key-change-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
REFRESH_COOKIE_NAME=aiq_rt

# CORS & Origins
FRONT_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3001
BACKEND_PORT=3001

# Email Configuration - Resend
EMAIL_FROM="AIQUAA Dev <dev@aiquaa.com>"
RESEND_API_KEY=re_Vo8z4maQ_8ruYVtSYkU5Ye1ue2CPDPbcT
RESEND_FROM_EMAIL=onboarding@resend.dev

# OAuth Providers - Google (Development)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Providers - GitHub (Development)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Redis Cache (Optional for development)
REDIS_URL=redis://localhost:6379

# Sentry (Optional for development)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# OpenTelemetry (Optional for development)
OTEL_ENDPOINT=

# Supabase (Optional for development)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

