# Configuración de producción para el backend AIQUAA
# Estas variables deben ser configuradas en tu plataforma de hosting

# Database - Supabase
DATABASE_URL="postgresql://replace-user:replace-password@replace-host:6543/replace-db?sslmode=require&pgbouncer=true"

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
REFRESH_COOKIE_NAME=aiq_rt

# CORS & Origins
FRONT_ORIGIN=https://aiquaa.com
APP_URL=https://aiquaabackend-production.up.railway.app
BACKEND_URL=https://aiquaabackend-production.up.railway.app
BACKEND_PORT=3001

# Email Configuration - Resend
EMAIL_FROM="AIQUAA <no-reply@aiquaa.com>"
RESEND_API_KEY=re_replace_with_real_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
SMTP_URL=smtp://user:pass@your-smtp-server:587

# OAuth Providers - Google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# OAuth Providers - GitHub
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# Redis Cache
REDIS_URL=redis://your-redis-server:6379

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production

# OpenTelemetry
OTEL_ENDPOINT=http://your-otel-endpoint:4318

# Supabase
SUPABASE_URL=https://replace-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-real-service-role-key
