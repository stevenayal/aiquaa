{
  "name": "@aiquaa/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p $FRONTEND_PORT",
    "prebuild": "node scripts/check-env.js",
    "build": "cd ../../packages/allpairs-core && pnpm build && cd ../../apps/frontend && next build",
    "start": "next start",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:bdd": "cucumber-js --config .cucumberrc.js",
    "test:bdd:watch": "cucumber-js --config .cucumberrc.js --watch",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "postbuild": "next-sitemap",
    "auth:check": "node -e \"fetch(process.env.NEXTAUTH_URL + '/api/auth/signin').then(r=>{if(r.status<400)process.exit(0);process.exit(1)}).catch(()=>process.exit(1))\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aiquaa/allpairs-core": "workspace:*",
    "@aiquaa/shared": "workspace:*",
    "@axe-core/playwright": "^4.8.0",
    "@fontsource/sora": "^5.2.6",
    "@hookform/resolvers": "^5.2.2",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.40.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@sentry/nextjs": "^7.100.1",
    "@sentry/react": "^7.100.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/sanitize-html": "^2.9.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vercel/og": "^0.6.3",
    "autoprefixer": "^10.4.16",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "^13.5.6",
    "eslint-plugin-react-hooks": "^4.6.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^23.0.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.460.0",
    "msw": "^2.0.0",
    "next": "^13.5.6",
    "next-auth": "4.24.11",
    "next-sitemap": "^4.2.3",
    "papaparse": "^5.5.3",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.66.0",
    "recharts": "^3.1.1",
    "sanitize-html": "^2.12.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.3.6",
    "typescript": "~5.3.3",
    "uuid": "^11.1.0",
    "vitest": "^1.0.0",
    "whatwg-fetch": "^3.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/chai": "^4.3.0",
    "@types/jspdf": "^2.0.0",
    "@types/node": "^20.19.10",
    "@types/papaparse": "^5.3.16",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^1.6.1",
    "chai": "^4.3.0",
    "cucumber-html-reporter": "^7.0.0",
    "ts-node": "^10.9.0"
  }
}
