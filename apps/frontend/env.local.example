# Variables de entorno para DESARROLLO LOCAL
# Copia este archivo a .env.local y configura los valores

# URL de la API del backend (desarrollo local)
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL base para el proxy (dejar vacío para usar rutas relativas)
NEXT_PUBLIC_API_BASE=

# URL del backend para el proxy serverless
BACKEND_URL=http://localhost:3001

# NextAuth Secret (genera uno con: openssl rand -base64 32)
NEXTAUTH_SECRET=your-dev-nextauth-secret-here

# NextAuth URL (desarrollo local)
NEXTAUTH_URL=http://localhost:3000

# NextAuth URL interna (opcional para App Router)
NEXTAUTH_URL_INTERNAL=http://localhost:3000

# Google OAuth (para NextAuth) - Configura en Google Cloud Console
GOOGLE_CLIENT_ID=your-dev-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-dev-google-client-secret

# GitHub OAuth (para NextAuth) - Configura en GitHub Developer Settings
GITHUB_CLIENT_ID=your-dev-github-client-id
GITHUB_CLIENT_SECRET=your-dev-github-client-secret

# Google Analytics (opcional en desarrollo)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN (opcional en desarrollo)
NEXT_PUBLIC_SENTRY_DSN=https://your-dev-sentry-dsn@sentry.io/project-id

# Feature flag para deshabilitar registro (opcional)
NEXT_PUBLIC_DISABLE_REGISTRATION=false

# Supabase — necesario para auth y sesiones
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key: SERVER-SIDE ONLY. Nunca usar NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend — usado para enviar emails de confirmación sin tocar el límite de Supabase
RESEND_API_KEY=re_replace_with_real_resend_api_key
RESEND_FROM_EMAIL="AIQUAA <noreply@aiquaa.com>"

# URL pública del sitio (para links de confirmación en emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
