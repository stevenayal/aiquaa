# Variables de entorno para el frontend
# Copia este archivo a .env.local y configura los valores

# URL de la API del backend
NEXT_PUBLIC_API_URL=https://api.aiquaa.com

# URL del backend (alternativa a NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_BACKEND_URL=https://api.aiquaa.com

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN para monitoreo de errores
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Token para revalidación de caché
REVALIDATE_TOKEN=your-secret-token-here

# Configuración de OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=91995874414-kqjeag1g4h46nmlg1nodb7aqb6jud80r.apps.googleusercontent.com
