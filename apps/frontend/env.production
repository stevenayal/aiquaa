# Variables de entorno para producción
# Estas variables deben ser configuradas en Vercel

# URL de la API del backend
NEXT_PUBLIC_API_URL=https://api.aiquaa.com

# URL del backend (alternativa a NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_BACKEND_URL=https://api.aiquaa.com

# Google Analytics Measurement ID (configurar en Vercel)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN para monitoreo de errores (configurar en Vercel)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Token para revalidación de caché (configurar en Vercel)
REVALIDATE_TOKEN=your-secret-token-here

# Configuración de OAuth (configurar en Vercel)
