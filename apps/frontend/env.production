# Variables de entorno para PRODUCCIÓN
# ⚠️ NO incluir este archivo en el repositorio

# URL de la API del backend
NEXT_PUBLIC_API_URL=https://aiquaabackend-production.up.railway.app

# URL base para el proxy (dejar vacío para usar rutas relativas)
NEXT_PUBLIC_API_BASE=

# URL del backend para el proxy serverless
BACKEND_URL=https://aiquaabackend-production.up.railway.app

# NextAuth Secret (generado con: openssl rand -base64 32)
NEXTAUTH_SECRET=your-production-nextauth-secret-here

# NextAuth URL (debe coincidir con tu dominio de producción)
NEXTAUTH_URL=https://aiquaa.com

# NextAuth URL interna (opcional para App Router)
NEXTAUTH_URL_INTERNAL=https://aiquaa.com

# Google OAuth (para NextAuth)
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# GitHub OAuth (para NextAuth)
GITHUB_CLIENT_ID=your-production-github-client-id
GITHUB_CLIENT_SECRET=your-production-github-client-secret

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN
NEXT_PUBLIC_SENTRY_DSN=https://your-production-sentry-dsn@sentry.io/project-id
