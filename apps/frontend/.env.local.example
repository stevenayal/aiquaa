# NextAuth Configuration
NEXTAUTH_SECRET=change-me-to-a-secure-random-string-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# API Configuration
# Para desarrollo local:
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Para producción (Vercel), configurar en Vercel Dashboard:
# NEXT_PUBLIC_API_URL=https://aiquaabackend-production.up.railway.app
# NEXT_PUBLIC_BACKEND_URL=https://aiquaabackend-production.up.railway.app
# NEXTAUTH_URL=https://tu-dominio.vercel.app

# OAuth Providers - Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Providers - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Optional: Disable registration
# NEXT_PUBLIC_DISABLE_REGISTRATION=false

# Optional: Allowed domain for registration
# ALLOWED_DOMAIN=example.com

# Bug Report Widget - GitHub Integration
# Para crear el token: https://github.com/settings/tokens
# Permisos necesarios: repo (para crear issues)
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO=stevenayal/aiquaa

# Notificaciones internas — alerta por email al registrar empresa
BACKEND_INTERNAL_URL=http://localhost:3001
INTERNAL_NOTIFY_SECRET=replace_with_a_random_secret_32chars

# ─── SEGURIDAD (requeridas en Vercel Dashboard) ────────────────────────────
# URL de producción del frontend — usada para validar CORS en /api/register
# Vercel: Settings → Environment Variables → NEXT_PUBLIC_SITE_URL
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Clave de acceso al panel de admin del Test App (/labs/test-app/admin)
# Generar con: node -e "require('crypto').randomBytes(24).toString('base64url')|console.log"
# NUNCA usar el valor por defecto en producción
NEXT_PUBLIC_ADMIN_KEY=local-dev-only-change-in-vercel
