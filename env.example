# Variables de entorno para AIQUAA
# Copia este archivo como .env.local y configura los valores

# ===== FRONTEND =====
# URL de la API del backend
NEXT_PUBLIC_API_URL=https://aiquaabackend-production.up.railway.app

# NextAuth Secret (generado con: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-here

# NextAuth URL (debe coincidir con tu dominio)
NEXTAUTH_URL=https://aiquaa.com

# Google OAuth (para NextAuth)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (para NextAuth)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google Analytics (opcional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN (opcional)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===== BACKEND =====
# Database - Supabase
DATABASE_URL=postgres://user:password@host:port/database

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
REFRESH_COOKIE_NAME=aiq_rt

# CORS & Origins
FRONT_ORIGIN=https://aiquaa.com
APP_URL=https://aiquaabackend-production.up.railway.app
BACKEND_PORT=3001

# Email Configuration - Resend
EMAIL_FROM="AIQUAA <no-reply@aiquaa.com>"
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# OAuth Providers - Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Providers - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Redis Cache (opcional)
REDIS_URL=redis://your-redis-server:6379

# Sentry (opcional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production

# OpenTelemetry (opcional)
OTEL_ENDPOINT=http://your-otel-endpoint:4318

# Supabase (opcional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key